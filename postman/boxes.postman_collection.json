            "body": {
              "mode": "raw",
              "raw": "{\n  \"productos\": [\n    {\n      \"id\": {{productoId}},\n      \"precio_venta\": 220,\n      \"stock_minimo\": 3\n    },\n    {\n      \"id\": 2,\n      \"nombre_producto\": \"Caja chica\",\n      \"activo\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },

              "body": "{\n  \"statusCode\": 400,\n  \"timestamp\": \"2026-10-09T15:00:00.000Z\",\n  \"path\": \"/productos/importacion\",\n  \"message\": [\n    \"Fila 3: Categoría 999999999 no existe.\"\n  ]\n}"
            }

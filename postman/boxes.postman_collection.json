                  "key": "Content-Type",
                  "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                },
                {
                  "key": "Content-Disposition",
                  "value": "attachment; filename=\"plantilla-productos.xlsx\""
                }
              ],
              "body": ""
            }
          ]
        },
        {
          "name": "Importar productos desde Excel",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/productos/importacion",
            "description": "Campo archivo: el .xlsx de la plantilla con filas de productos. Máximo 500 filas y 2 MB. es_servicio y activo aceptan sí/no, verdadero/falso o 1/0. impuesto_preset_ids va separado por comas. Si una fila falla, no se guarda ninguna. 413 si el archivo supera 2 MB.",
            "body": {
              "mode": "formdata",
              "formdata": [

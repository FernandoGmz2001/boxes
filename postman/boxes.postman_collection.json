                }
              ],
              "body": "{\n  \"creados\": 1,\n  \"productos\": [\n    {\n      \"id\": 2,\n      \"nombre_producto\": \"Caja importada\",\n      \"imagen_url\": null,\n      \"cantidad_en_existencia\": 4,\n      \"stock_minimo\": 1,\n      \"sku\": null,\n      \"codigo_barras\": null,\n      \"precio_venta\": \"15.50\",\n      \"costo_compra\": \"4.00\",\n      \"es_servicio\": false,\n      \"activo\": true,\n      \"id_categoria\": 1,\n      \"clave_producto_servicio\": null,\n      \"clave_unidad_medida\": null,\n      \"objeto_impuesto\": null,\n      \"created_at\": \"2026-10-09T15:00:00.000Z\",\n      \"updated_at\": \"2026-10-09T15:00:00.000Z\",\n      \"impuestos\": []\n    }\n  ]\n}"
            },
